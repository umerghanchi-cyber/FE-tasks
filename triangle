
import java.util.Scanner;

public class tri {
    static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int x = input.nextInt();

        for (int i=0 ; i<=x ; i++){
            System.out.println();
            for (int j=0 ; j<=i ; j++){
                System.out.print("*");
            }
        }
    }
}
