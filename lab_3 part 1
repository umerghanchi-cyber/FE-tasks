package Lab03_CalculatorOverloading;

public class Calculator {

    // Integer Addition
    int add(int a, int b) {
        return a + b;
    }

    // Double Addition
    double add(double a, double b) {
        return a + b;
    }

    // Maximum of 2 numbers
    int max(int a, int b) {

        if (a > b)
            return a;
        else
            return b;
    }

    // Maximum of 3 numbers
    int max(int a, int b, int c) {

        int largest = a;

        if (b > largest)
            largest = b;

        if (c > largest)
            largest = c;

        return largest;
    }
}
