package Tasks;

import java.util.*;

public class Arrays {
    static void main(String[] args) {
        ArrayList<Integer> List= new ArrayList<>(Arrays.asList(1,2,3,2,4,5,3,6,1));
        Set<Integer> seen= new HashSet<>();
        Set<Integer> duplicates= new HashSet<>();

        for (Integer num : List){
            if (!seen.add(num)){
                duplicates.add(num);
            }
        }
               System.out.println(duplicates);
    }
}
