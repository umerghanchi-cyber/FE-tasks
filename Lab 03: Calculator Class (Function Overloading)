class Calculator {

    int add(int a, int b) {
        return a + b;
    }

    double add(double a, double b) {
        return a + b;
    }

    int max(int a, int b) {
        if (a > b)
            return a;
        else
            return b;
    }

    int max(int a, int b, int c) {
        if (a >= b && a >= c)
            return a;
        else if (b >= a && b >= c)
            return b;
        else
            return c;
    }
}

public class Main {

    public static void main(String[] args) {

        Calculator c = new Calculator();

        System.out.println("Integer Add: " + c.add(10, 20));
        System.out.println("Double Add: " + c.add(10.5, 20.5));

        System.out.println("Max of Two: " + c.max(15, 25));
        System.out.println("Max of Three: " + c.max(10, 30, 20));
    }
}
