package Task;

import java.util.Scanner;

public class main {
    static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the Number : ");
        int x=sc.nextInt();

        for(int i=1; i<=10; i++){
            System.out.println(x+" * "+ i+ " = " + (i*x));

        }
    }
}
