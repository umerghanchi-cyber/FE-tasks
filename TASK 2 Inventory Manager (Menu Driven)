package Lab08_HashMapTasks;

import java.util.HashMap;
import java.util.Scanner;

public class Task2_InventoryManager {

    static HashMap<String, Integer> inventory = new HashMap<>();

    // Add Stock
    public static void addStock(String product, int quantity) {

        if (inventory.containsKey(product)) {

            inventory.put(product, inventory.get(product) + quantity);

        } else {

            inventory.put(product, quantity);
        }

        System.out.println("Stock Added.");
    }

    // Remove Stock
    public static void removeStock(String product, int quantity) {

        if (inventory.containsKey(product)) {

            int current = inventory.get(product);

            if (current >= quantity) {

                inventory.put(product, current - quantity);

                System.out.println("Stock Removed.");

            } else {

                System.out.println("Not enough stock.");
            }

        } else {

            System.out.println("Product not found.");
        }
    }

    // Check Stock
    public static void checkStock(String product) {

        if (inventory.containsKey(product)) {

            System.out.println(product + " = " + inventory.get(product));

        } else {

            System.out.println("Product not found.");
        }
    }

    // Display All Products
    public static void displayProducts() {

        System.out.println("\nCurrent Inventory:");

        for (String product : inventory.keySet()) {

            System.out.println(product + " : " + inventory.get(product));
        }
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Initial Inventory
        inventory.put("Apples", 50);
        inventory.put("Bananas", 30);
        inventory.put("Oranges", 40);

        int choice;

        do {

            System.out.println("\n===== Inventory Menu =====");
            System.out.println("1. Add Stock");
            System.out.println("2. Remove Stock");
            System.out.println("3. Check Stock");
            System.out.println("4. Display Products");
            System.out.println("5. Exit");

            System.out.print("Enter Choice: ");
            choice = input.nextInt();

            input.nextLine();

            switch (choice) {

                case 1:

                    System.out.print("Enter Product: ");
                    String p1 = input.nextLine();

                    System.out.print("Enter Quantity: ");
                    int q1 = input.nextInt();

                    addStock(p1, q1);
                    break;

                case 2:

                    System.out.print("Enter Product: ");
                    String p2 = input.nextLine();

                    System.out.print("Enter Quantity: ");
                    int q2 = input.nextInt();

                    removeStock(p2, q2);
                    break;

                case 3:

                    System.out.print("Enter Product: ");
                    String p3 = input.nextLine();

                    checkStock(p3);
                    break;

                case 4:

                    displayProducts();
                    break;

                case 5:

                    System.out.println("Program Ended.");
                    break;

                default:

                    System.out.println("Invalid Choice.");
            }

        } while (choice != 5);

        input.close();
    }
}
